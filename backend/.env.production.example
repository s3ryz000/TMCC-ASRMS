# TMCC ASRMS: settings for the server at TMCC (#61). See deploy\INSTALL.md.
# Copy this file to backend\.env on the server and replace every <...>.
# backend\.env is never committed: it holds the database password and APP_KEY.

APP_NAME="TMCC ASRMS"
APP_ENV=production
# Filled in by "php artisan key:generate". Never copy it from another PC.
APP_KEY=
# Must stay false: true shows SQL, file paths and other internals on errors.
APP_DEBUG=false
# The address staff open in the browser (the same for both lines), e.g.
# http://asrms.tmcc.local or http://192.168.1.20
APP_URL=http://<server name or IP>
FRONTEND_URL=http://<server name or IP>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL from XAMPP (see deploy\DATABASE-DECISION.md). ASRMS has its own
# database user; never use root here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asrms
DB_USERNAME=asrms
DB_PASSWORD=<choose a strong password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# No e-mail on the campus LAN.
MAIL_MAILER=log

# Backups (#62): a folder on the server's SECOND drive, never on C:.
ASRMS_BACKUP_PATH=D:\ASRMS-Backups
ASRMS_MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
ASRMS_MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe

# Login sessions (#86): signed out after 60 minutes without activity, and
# 12 hours after signing in.
ASRMS_SESSION_IDLE_MINUTES=60
ASRMS_SESSION_MAX_HOURS=12
